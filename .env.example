# Local-only configuration. Copy to .env and chmod 600.
F90_BASE_URL=http://192.168.100.1
F90_USERNAME=admin
F90_PASSWORD=change-me

# auto probes the nonce login first and falls back to the legacy F90/ZTE login.
F90_AUTH_MODE=auto

# Keep this list equal to the bands exposed by this F90 firmware.
F90_BANDS=1,3,7,8,20,28,38,40,41
F90_FAST_SCAN_BANDS=7,1,20

# Default: one pinned Cloudflare HTTPS endpoint, no speedtest.net discovery.
F90_SPEEDTEST_BACKEND=cloudflare
# Optional legacy Ookla backend: F90_SPEEDTEST_BACKEND=speedtest
# Optional: pin an Ookla server (speedtest backend only).
# F90_SPEEDTEST_SERVER_ID=
F90_SPEEDTEST_TESTS=3
# Cloudflare uses fixed 8 MiB down / 2 MiB up, 90s transfer timeout,
# identical for every Band. Sizes are constants in src/f90_band_manager/cloudflare.py.
# Per HTTP request: allow slow mobile connections and server discovery.
F90_SPEEDTEST_REQUEST_TIMEOUT=30

# Required: direct USB OLAX interface. No VPN configuration is needed.
# Confirm the name after moving the modem to another USB port.
F90_OLAX_INTERFACE=enp0s20f0u4

# HTTP probes remain disabled: test traffic needs a verified OLAX route.
# Keep F90_WARMUP_URL and F90_PROBE_URL empty.
